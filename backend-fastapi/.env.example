# ============================================================
# PAIDEA FASTAPI CONFIGURATION
# ============================================================

# Entorno: development | production | test
ENVIRONMENT=development
PROJECT_NAME="PAIDEA Reloaded API"
API_V1_PREFIX=/api/v1

# Base de Datos:
# Opción A (PostgreSQL local con Docker):
# DATABASE_URL=postgresql+asyncpg://paidea_user:paidea_password@localhost:5432/paidea_db
# Opción B (SQLite local directo sin Docker):
DATABASE_URL=sqlite+aiosqlite:///./paidea.db

# Seguridad y Autenticación JWT
SECRET_KEY=paidea_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (Orígenes permitidos separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# IA y Agente Conversacional (TecnoBurro)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CHROMA_PERSIST_DIRECTORY=./chroma_data
